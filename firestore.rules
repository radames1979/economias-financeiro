rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Phase 3: Primitive Definition
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return request.auth != null; }
    function isVerified() { return isSignedIn() && request.auth.token.email_verified == true; }
    
    // Admin check - Hardcoded for bootstrap or lookup
    function isAdmin() { 
      return isSignedIn() && (
        request.auth.token.email == 'bernardoaster@gmail.com'
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Validation Helpers
    function isValidUser(data) {
      return data.uid == request.auth.uid;
    }

    function isValidTransaction(data, userId) {
      return data.userId == userId &&
             data.type in ['income', 'expense', 'transfer'] &&
             data.amount is number &&
             data.date is string &&
             data.accountId is string &&
             data.description is string &&
             (!('notes' in data) || data.notes is string || data.notes == null) &&
             (!('consolidated' in data) || data.consolidated is bool) &&
             (!('paid' in data) || data.paid is bool) &&
             (!('categoryId' in data) || data.categoryId is string || data.categoryId == null) &&
             (!('costCenterId' in data) || data.costCenterId is string || data.costCenterId == null) &&
             (!('toAccountId' in data) || data.toAccountId is string || data.toAccountId == null) &&
             (!('groupId' in data) || data.groupId is string || data.groupId == null) &&
             (!('paymentDate' in data) || data.paymentDate is string || data.paymentDate == null) &&
             (!('attachmentUrl' in data) || data.attachmentUrl is string || data.attachmentUrl == null) &&
             (!('attachmentName' in data) || data.attachmentName is string || data.attachmentName == null) &&
             (!('createdAt' in data) || data.createdAt is timestamp || data.createdAt == null) &&
             (!('updatedAt' in data) || data.updatedAt is timestamp || data.updatedAt == null) &&
             (!('id' in data) || data.id is string);
    }

    function isValidTransactionGroup(data, userId) {
      return data.userId == userId &&
             data.name is string && data.name.size() > 0;
    }

    function isValidAccount(data, userId) {
      return data.userId == userId &&
             data.name is string && data.name.size() > 0 &&
             data.balance is number &&
             (!('currency' in data) || data.currency is string) &&
             (!('exchangeRate' in data) || data.exchangeRate is number) &&
             (!('includeInMainBalance' in data) || data.includeInMainBalance is bool) &&
             (!('includeInNetWorth' in data) || data.includeInNetWorth is bool);
    }

    function isValidCategory(data, userId) {
      return data.userId == userId &&
             data.name is string && data.name.size() > 0 &&
             data.type in ['income', 'expense', 'transfer'];
    }

    function isValidRecurringTransaction(data, userId) {
      return data.userId == userId &&
             data.description is string &&
             data.amount is number &&
             data.type in ['income', 'expense'];
    }

    function isValidSentEmail(data, userId) {
      return data.userId == userId &&
             data.email is string &&
             data.subject is string &&
             data.body is string &&
             data.sentAt is string;
    }

    // Rules matching blueprint paths
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) || isAdmin();

      match /sent_emails/{emailId} {
        allow list, get: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId) && isValidSentEmail(incoming(), userId);
        allow update: if isOwner(userId) && isValidSentEmail(incoming(), userId);
        allow delete: if isOwner(userId) || isAdmin();
      }

      match /transactions/{transactionId} {
        allow list: if isOwner(userId);
        allow get: if isOwner(userId) || isAdmin();
        allow create, update: if isOwner(userId) && request.auth.uid == userId && isValidTransaction(incoming(), userId);
        allow delete: if (isOwner(userId) && request.auth.uid == userId) || isAdmin();
      }

      match /accounts/{accountId} {
        allow list: if isOwner(userId);
        allow get: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId) && isValidAccount(incoming(), userId);
        allow update: if isOwner(userId) && isValidAccount(incoming(), userId);
        allow delete: if isOwner(userId) || isAdmin();
      }

      match /categories/{categoryId} {
        allow list: if isOwner(userId);
        allow get: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId) && isValidCategory(incoming(), userId);
        allow update: if isOwner(userId) && isValidCategory(incoming(), userId);
        allow delete: if isOwner(userId) || isAdmin();
      }

      match /recurring_transactions/{recurringId} {
        allow list: if isOwner(userId);
        allow get: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId) && isValidRecurringTransaction(incoming(), userId);
        allow update: if isOwner(userId) && isValidRecurringTransaction(incoming(), userId);
        allow delete: if isOwner(userId) || isAdmin();
      }

      match /transaction_groups/{groupId} {
        allow list: if isOwner(userId);
        allow get: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId) && isValidTransactionGroup(incoming(), userId);
        allow update: if isOwner(userId) && isValidTransactionGroup(incoming(), userId);
        allow delete: if isOwner(userId) || isAdmin();
      }
    }

    match /admins/{adminId} {
      allow read: if isAdmin();
      allow write: if false; // Only manageable via Firebase Console or special script
    }
  }
}
